  "numerical_policy": {
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-09,
    "direction_degeneracy_tolerance": 1e-12,
    "description": "Numerical precision only; no biological or physical acceptance threshold."
  },
  "conventions": {
    "arrival": "receiver toward arriving-light origin; opposite photon travel",
    "area": "supported one-sided m2",
    "received": "two faces per one-sided area",
    "matrix": "column vectors; second order xx,xy,xz,yy,yz,zz",
    "schedule": "Explicit daily lit intervals; outside a supplied complete schedule is off. Absent schedule is unknown.",
    "moments": "Sum unnormalized flux moments before normalization; never sum all plus fixture rows.",
    "tissue_dli": "light_dose.csv dli_mol_m2_day is supported-tissue incident DLI on its area_basis_id, not a reference-position sensor-plane value; whole-plant model scope does not mean a tissue average.",
    "reference_dli": "Implemented measured_logged and measured_spot_schedule incident reference-position complete-day DLI; hashed result, declared plane, separate basis, evidence and P3 domain required. Simulation is readiness only. Availability is per supplied result, only for explicitly associated plant instances.",
    "growth_orientation": "Arrival vectors/moments are illumination diagnostics, never growth orientation parameters; P3 owns rejecting such bindings.",
    "nonlinear_light_use": "Sum simultaneous fixtures on the same patch/time before nonlinear exchange, without adding all twice or applying absorptance twice. D15-D20 dwarf-source P4 uses absorbed PPFD, before_mito and evidenced adaxial_only; P4 owns two-face refusal and coefficient-basis issues.",
    "sample_moments": "Actual direct paths reduced to area-weighted unnormalized grow-frame F/M/B per receiver; units umol/s. receiver_index is global within the source call. Unknown path count is null for unavailable fixture inventory. No native/direct mixture.",
    "illuminated_faces": "Actual positive normal/opposite photon contributions plus reviewed biological mapping. Zero, unknown exposure or missing identity remains unavailable. Aggregate simultaneous fixtures before classifying all. No clipping, halving, changed absorption or Native face claims."
  },
  "required_json": [
    "package.json",
    "schema.json",
    "transforms.json",
    "availability.json",
    "consumer_mapping.json",
    "capabilities.json",
    "audit.json",
    "angular_diagnostics.json",
    "reference_channel.json",
    "face_mappings.json"
  ],
  "region_convention": "Explicit measured local frame: +x attachment-to-tip chord; +y reviewed transverse. Left y<0, right y>0; proximal x<declared boundary, distal x>boundary. Numerical boundary samples stay unassigned. Means describe supported tissue only.",
  "angular_protocol": "direct-angular-1",
  "request_extensions": {
    "reference_dli": {
      "optional": true,
      "fields": {
        "path": "reference_dli.json, relative to package request or absolute",
        "sha256": "SHA256 of the producer JSON"
      },
      "missing": "implemented channel, reference_inputs_not_supplied",
      "unavailable": "retain full evidence; expose no usable value"
    },
    "face_mappings": {
      "optional": true,
      "scope_fields": [
        "geometry_snapshot_id",
        "plant_instance_id",
        "session_id",
        "organ_id",
        "leaflet_id",
        "triangle_id"
      ],
      "evidence_fields": [
        "mapping_id",
        "geometry_sha256",
        "normal_biological_face",
        "review_status",
        "reviewer",
        "evidence_path",
        "evidence_sha256"
      ],
      "meaning": "Reviewed normal-to-biological-face identity for one original triangle. Actual positive transport contributions determine exposed faces after fixture and schedule summation."
    }
  }
